# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Anthropic — server-held. No accounts, so this one key funds every request;
# access is gated by multi-use codes instead (see app/code_store.py).
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Three tiers, picked per step by how much the output shapes the client-facing
# result (see CLAUDE.md "Model tiers"):
#   QUALITY  - generative steps whose content is the result (personas, prompts,
#              categories, insights). Few calls per job.
#   MODEL    - the buyer-persona "answer" call (the signal being measured) and
#              judgement calls like brand detection / source classification.
#   FAST     - mechanical work only (sentiment, relevance filter, running the source search).
ANTHROPIC_QUALITY_MODEL=claude-opus-5-5
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_RETRIES=2
# Per-call timeout, and calls in flight at once across all jobs.
ANTHROPIC_TIMEOUT_SECONDS=180
ANTHROPIC_MAX_CONCURRENCY=16

# Access codes
# Set this to enable POST/GET /admin/codes for minting codes over HTTP.
# Leave unset to disable those routes and mint only via the CLI script:
#   docker compose exec api python -m app.scripts.mint_codes 10 5   # 10 codes, 5 uses each
ADMIN_SECRET=
CODES_DB_PATH=/app/data/codes.db
MAX_PROMPT_CALLS_PER_CODE=10
# Failed code / admin-secret lookups allowed per 10 minutes, per client IP and
# across all clients, before lookups are refused (app/rate_limit.py).
CODE_FAILURES_PER_IP=20
CODE_FAILURES_GLOBAL=1000
CODE_FAILURE_WINDOW_SECONDS=600
# Read by uvicorn: which proxies may set X-Forwarded-For. Behind a platform
# proxy (Railway/Render) set it to that proxy's address range, never "*": with
# "*" any client can claim a new IP per request and dodge the per-IP limit.
# Left at 127.0.0.1 behind a proxy, every client shares the proxy's IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# Pipeline
PROMPTS_PER_PERSONA=3
PERSONA_CONCURRENCY=4
# A redemption unfinished after this long is a lost job and its use is refunded.
STALE_JOB_SECONDS=3600
JOB_TTL_SECONDS=1800
